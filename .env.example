# Markdown Note Taker — Environment Variables
# Copy this file to .env and fill in the values.
# No secrets are required for local development.

# Application
VITE_APP_TITLE=Markdown Note Taker

# Optional: override the localStorage key used for note persistence
VITE_STORAGE_KEY=markdown-note-taker-notes

# Optional: set the debounce interval (in milliseconds) for auto-save
VITE_AUTO_SAVE_DEBOUNCE_MS=500
